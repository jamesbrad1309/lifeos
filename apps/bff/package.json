{
  "name": "bff",
  "private": true,
  "version": "0.0.0",
  "imports": {
    "#common/*": {
      "types": "./src/common/*.ts",
      "default": "./dist/common/*.js"
    },
    "#clients/*": {
      "types": "./src/clients/*.ts",
      "default": "./dist/clients/*.js"
    },
    "#graphql/*": {
      "types": "./src/graphql/*.ts",
      "default": "./dist/graphql/*.js"
    }
  },
  "scripts": {
    "dev": "pnpm run build && concurrently -k -n tsc,node \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json && node scripts/copy-graphql-assets.mjs",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/load-files": "^7.0.0",
    "@graphql-tools/merge": "^9.0.0",
    "@graphql-tools/schema": "^10.0.0",
    "dataloader": "^2.2.2",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "graphql": "catalog:",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.0",
    "concurrently": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "typescript": "catalog:"
  }
}
