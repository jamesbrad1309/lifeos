{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "imports": {
    "#habits/*": {
      "types": "./src/habits/*.ts",
      "default": "./dist/habits/*.js"
    },
    "#habit-entries/*": {
      "types": "./src/habit-entries/*.ts",
      "default": "./dist/habit-entries/*.js"
    },
    "#common/*": {
      "types": "./src/common/*.ts",
      "default": "./dist/common/*.js"
    },
    "#graphql/*": {
      "types": "./src/graphql/*.ts",
      "default": "./dist/graphql/*.js"
    }
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "pnpm run build && concurrently -k -n tsc,node \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "prisma generate && tsc -p tsconfig.json && node scripts/copy-graphql-assets.mjs",
    "start": "prisma migrate deploy && node dist/main.js",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/load-files": "^7.0.0",
    "@graphql-tools/merge": "^9.0.0",
    "@graphql-tools/schema": "^10.0.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^6.1.0",
    "dataloader": "^2.2.2",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "graphql": "catalog:",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.0",
    "concurrently": "^9.0.0",
    "dotenv-cli": "^7.4.4",
    "pino-pretty": "^13.1.3",
    "typescript": "catalog:"
  }
}
